      {
        "token": "string.quoted.double",
        "regex": "\"[^\"]*\""
      },
      {
        "token": "keyword.control",
        "regex": "T=\"[^\"]+\"|(?:CYCLE|POCKET|HOLES|SLOT)\\d+|LONGHOLE|WORKPIECE|MCALL|M30|"
      },
      {
        "token": "support.function",
        "regex": "\\b(?:SQRT|ASIN|ACOS|ATAN|ATAN2|SIN|COS|TAN|ABS|POT|TRUNC|LN|EXP|BIN|BCD|ROUND|FIX|FUP|TOUPPER|TOLOWER|STRLEN|INDEX|RINDEX|MINDEX|MATCH|SUBSTR|ISNUMBER|NUMBER|AXNAME|AXSTRING)\\b"
      },
      {
        "token": "variable.other.system.siemens",
        "regex": "\\$[A-Za-z0-9_]+(?:\\[[^\\]]+\\])?"
      },
      {
        "token": "variable.other.named.siemens",
        "regex": "\\b[A-Za-z_][A-Za-z0-9_]*(?:\\[[^\\]]+\\])?(?=\\s*(?:=|,|\\)|\\+|-|\\*|/|<|>))"
      },
      {
        "token": "keyword.operator",
        "regex": "<>|==|>=|<=|[\\+\\-\\*\\/=<>:]|\\b(?:M30|OR|NOT|XOR|DIV|MOD|B_AND|B_OR|B_NOT|B_XOR)\\b"
      },
      {
        "token": "variable.parameter",
        "regex": "\\bR(\\d+)\\b"
      },
      {
        "token": "constant.language.gcode",
        "regex": "[Gg]\\s*\\d+(?:\\.\\d+)?"
      },
      {
        "token": "constant.language.mcode",
        "regex": "[Mm]\\s*\\d+(?:\\.\\d+)?"
      },
      {
        "token": [
          "entity.name.tag",
          "constant.numeric"
        ],
        "regex": "([A-Z])(\\s*[+-]?\\d+(?:\\.\\d+)?)"
      }
    ],
    "max_execution_nodes": 50000,
    "file_extensions": {
      "multifile": false,
      "main": [
        ".MPF",
        ".mpf"
      ],
      "subprogram": [
        ".SPF",
        ".spf"
      ],
      "channels": {}
    }
  }
